{
  "protocol": {
    "protocol_version": "1.0.0",
    "project_name": "CivicTracker-TW",
    "evaluation_mode": "QUANTITATIVE_ONLY",
    "source_hash": "sha256:cb60861b9d57e8e70e95e5aaaf1e513ca02b7aababc6fd4d65b691c7d32fb487",
    "feature_flags": {
      "enable_ly_govapi_live_sync": true,
      "enable_ivod_video_embed": true,
      "enable_billy3321_integration": true,
      "enable_exam_report_cards": true,
      "enable_citizen_petitions": true,
      "enable_llm_deep_evaluation": false
    },
    "external_endpoints": {
      "ly_govapi_v2_url": "https://v2.ly.govapi.tw",
      "ly_open_data_url": "https://data.ly.gov.tw",
      "ivod_official_base_url": "https://ivod.ly.gov.tw",
      "billy3321_ivod_base_url": "https://ivod.billy3321.tw",
      "github_discussions_repo": "civic-tracker-tw/civic-tracker-tw"
    },
    "evidence_tier_policy": {
      "tier1_official_sources": [
        "中選會選舉公報",
        "政府電子採購網(PCC)",
        "立法院開放資料/公報",
        "審計部決算報告",
        "各縣市總預算與施政報告"
      ],
      "include_news_media": false,
      "policy_note": "新聞媒體真實性存疑，預設不計入執行率量化，僅作預留背景參考槽位；執行率與成果全數由 Tier-1 政府公開標案、法定公報與決算客觀量化。"
    },
    "routing": {
      "exec_agent": "hydrogen",
      "exec_model": "gemini-2.5-flash",
      "eval_agent": "argon",
      "eval_model": "gemini-4-argon",
      "max_retries": 2,
      "strict_evidence_check": true
    },
    "gates": {
      "TASK_SPEECH_PARSE": {
        "min_executor_confidence": 0.85,
        "sample_audit_rate": 0.2,
        "always_require_argon_verdict": false,
        "require_timestamp_bounds": true,
        "check_speaker_attribution": true
      },
      "TASK_VOTE_ANALYZE": {
        "min_executor_confidence": 0.9,
        "sample_audit_rate": 0.15,
        "always_require_argon_verdict": false,
        "allowed_vote_decisions": [
          "APPROVE",
          "REJECT",
          "ABSTAIN",
          "ABSENT"
        ]
      },
      "TASK_POLICY_EVAL": {
        "min_executor_confidence": 0.95,
        "sample_audit_rate": 0.0,
        "always_require_argon_verdict": true,
        "require_verifiable_citation": true,
        "allowed_fulfillment_statuses": [
          "NOT_STARTED",
          "IN_PLANNING",
          "IN_PROGRESS",
          "FULFILLED",
          "STALLED",
          "BROKEN"
        ]
      },
      "TASK_PETITION_TRIAGE": {
        "min_executor_confidence": 0.85,
        "sample_audit_rate": 0.0,
        "always_require_argon_verdict": true,
        "require_verifiable_citation": false
      }
    },
    "err_directives": {
      "E01_HALLUCINATION": {
        "severity": "CRITICAL",
        "model_directive": "Output contains claims not grounded in raw transcript or official document. Strip unsupported claims."
      },
      "E02_SPEAKER_SWAP": {
        "severity": "CRITICAL",
        "model_directive": "Confused statements made by the questioning legislator with responses from the executive official. Re-attribute speaker turns."
      },
      "E03_MISSING_CITATION": {
        "severity": "HIGH",
        "model_directive": "Policy milestone or vote record lacks a valid source_url or gazette reference. Attach exact provenance."
      },
      "E04_TIMESTAMP_DRIFT": {
        "severity": "MEDIUM",
        "model_directive": "Video start_time_sec/end_time_sec is inverted or out of session bounds. Recalculate timestamps."
      },
      "E05_SCHEMA_VIOLATION": {
        "severity": "HIGH",
        "model_directive": "Payload violates enum constraints or required fields in agent_protocol.json. Conform strictly to schema."
      },
      "E06_UNSUBSTANTIATED_ABUSE": {
        "severity": "HIGH",
        "model_directive": "Petition contains unsubstantiated defamation, abusive language, or zero public interest evidence. Quarantine and reject payload."
      }
    },
    "wire_schemas": {
      "HydrogenSubmissionEnvelope": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "HydrogenSubmissionEnvelope",
        "type": "object",
        "required": [
          "task_code",
          "submission_id",
          "confidence",
          "payload",
          "attempt"
        ],
        "properties": {
          "task_code": {
            "type": "string",
            "enum": [
              "TASK_SPEECH_PARSE",
              "TASK_VOTE_ANALYZE",
              "TASK_POLICY_EVAL",
              "TASK_PETITION_TRIAGE"
            ]
          },
          "submission_id": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "payload": {
            "type": "object"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "previous_error": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "E01_HALLUCINATION",
              "E02_SPEAKER_SWAP",
              "E03_MISSING_CITATION",
              "E04_TIMESTAMP_DRIFT",
              "E05_SCHEMA_VIOLATION",
              "E06_UNSUBSTANTIATED_ABUSE",
              null
            ]
          }
        }
      },
      "ArgonVerdictEnvelope": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "ArgonVerdictEnvelope",
        "type": "object",
        "required": [
          "verdict",
          "task_code",
          "submission_id",
          "confidence"
        ],
        "properties": {
          "verdict": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT"
            ]
          },
          "task_code": {
            "type": "string",
            "enum": [
              "TASK_SPEECH_PARSE",
              "TASK_VOTE_ANALYZE",
              "TASK_POLICY_EVAL",
              "TASK_PETITION_TRIAGE"
            ]
          },
          "submission_id": {
            "type": "string"
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "E01_HALLUCINATION",
              "E02_SPEAKER_SWAP",
              "E03_MISSING_CITATION",
              "E04_TIMESTAMP_DRIFT",
              "E05_SCHEMA_VIOLATION",
              "E06_UNSUBSTANTIATED_ABUSE",
              null
            ]
          },
          "model_directive": {
            "type": [
              "string",
              "null"
            ]
          },
          "evaluator_notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        }
      }
    }
  },
  "sync_status": {
    "is_synchronized": true,
    "human_config": "pipeline.human.yaml",
    "machine_protocol": "agent_protocol.json"
  }
}